{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recally-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recally-dev",
      "database_id": "9bac2bc2-57dd-4d9c-8868-682aeb290350",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARCHIVE_BUCKET", "bucket_name": "recally-archive-dev" }],
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "recally-chunks-dev" }],
  "ai": { "binding": "AI" },
  // Workflow classes live in the Jobs Worker (plan §3.1); cross-script binding.
  "workflows": [
    {
      "name": "ingest",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestWorkflow",
      "script_name": "recally-jobs"
    }
  ],
  // Skill markdown bundles as text modules.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "ENVIRONMENT": "dev",
    // Single-user instance: unauthenticated requests map to this library.
    // Requests with a valid rcl_ Bearer token resolve to that token's library.
    "DEV_LIBRARY_ID": "073440a4-915c-41df-a5da-b97c52ccb918"
  },
  "env": {
    // recally.io — the public deployment. Bindings and vars are NOT inherited
    // from the top level by named environments; they are duplicated here and
    // point at the same D1/R2/Vectorize/AI resources.
    "prod": {
      "workers_dev": true,
      // Workers routes (not custom_domain): they coexist with the zone's
      // existing proxied A records instead of requiring their deletion.
      "routes": [
        { "pattern": "recally.io/*", "zone_name": "recally.io" },
        { "pattern": "www.recally.io/*", "zone_name": "recally.io" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "recally-dev",
          "database_id": "9bac2bc2-57dd-4d9c-8868-682aeb290350"
        }
      ],
      "r2_buckets": [{ "binding": "ARCHIVE_BUCKET", "bucket_name": "recally-archive-dev" }],
      "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "recally-chunks-dev" }],
      "ai": { "binding": "AI" },
      "workflows": [
        {
          "name": "ingest",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow",
          "script_name": "recally-jobs"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "DEV_LIBRARY_ID": "073440a4-915c-41df-a5da-b97c52ccb918"
      }
    }
  }
}
