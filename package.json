{
  "name": "recally",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @recally/web build",
    "dev": "alchemy dev",
    "deploy": "pnpm --filter @recally/web build && alchemy deploy",
    "plan": "alchemy plan",
    "destroy": "alchemy destroy",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@oxlint/plugins": "1.83.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4"
}
