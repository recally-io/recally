{
  "name": "recally",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "types": "pnpm --filter @recally/api exec wrangler types && pnpm --filter @recally/jobs exec wrangler types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
