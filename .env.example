# Copy to .env at the repo root. Read by `alchemy deploy` / `alchemy dev`
# during the Construction phase; each set key is bound onto the workers as a
# secret. Never commit real values.

# Single-user instance: requests without a valid rcl_ Bearer token map to
# this library. (Auth is intentionally minimal for now.)
DEV_LIBRARY_ID=

# Model roles (Workers AI model IDs). Unset keys fall back to the defaults
# in packages/ai/src/models.ts.
CAPTURE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
VERIFY_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
SUMMARY_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
ANSWER_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
EMBEDDING_MODEL=@cf/baai/bge-m3

# Pi → Workers AI transport (jobs worker). Gateway route needs no API token.
AI_GATEWAY_NAME=
CLOUDFLARE_ACCOUNT_ID=
